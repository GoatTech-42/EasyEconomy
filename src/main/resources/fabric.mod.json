{
	"schemaVersion": 1,
	"id": "easyeconomy",
	"version": "${version}",
	"name": "EasyEconomy",
	"description": "a simple server-side economy: balances, shops, currency items and challenges. geyser friendly.",
	"authors": [ "GoatTech" ],
	"contact": {
		"sources": "https://github.com/GoatTech-42/EasyEconomy",
		"issues": "https://github.com/GoatTech-42/EasyEconomy/issues"
	},
	"license": "MIT",
	"icon": "assets/easyeconomy/icon.png",
	"environment": "*",
	"mixins": [ "easyeconomy.mixins.json" ],
	"entrypoints": {
		"main": [ "dev.easyeconomy.EasyEconomyMod" ],
		"client": [ "dev.easyeconomy.pack.EasyEconomyClientPack" ]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${mc}",
		"java": ">=${java}",
		"fabric-api": "*"
	}
}
